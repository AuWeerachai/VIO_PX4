#!/usr/bin/env python3
"""Select next-launch camera mode without restarting running processes."""
import argparse
import json
import os
from pathlib import Path

parser = argparse.ArgumentParser()
parser.add_argument('mode', nargs='?', choices=['vio', 'vo'])
args = parser.parse_args()
config = Path.home()/'.config/vio-launch/config.json'
saved = json.loads(config.read_text()) if config.exists() else {}
workspace = Path(os.environ.get('ISAAC_ROS_WS') or saved.get('isaac_ros_dir') or Path.home()/'workspaces/isaac_ros-dev').expanduser()
path = workspace/'src/isaac_ros_common/scripts/vio_imu_mode'
if args.mode:
    if not path.parent.is_dir():
        parser.error(f'Isaac workspace is not installed: {workspace}')
    tmp = path.with_suffix('.tmp')
    tmp.write_text(args.mode+'\n')
    tmp.replace(path)
mode = path.read_text().strip() if path.exists() else 'vio'
print('Selected camera mode:', mode.upper(), '(stereo + IMU)' if mode == 'vio' else '(stereo only)')
if args.mode:
    print('Fully stop the current camera session, then restart through ~/vio-launch.')
