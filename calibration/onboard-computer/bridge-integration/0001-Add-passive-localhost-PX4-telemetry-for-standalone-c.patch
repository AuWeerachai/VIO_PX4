 class Phase(Enum):
@@ -384,6 +385,7 @@ class VioPx4GpsBridge(Node):
         self._mav = None
         self._gps_pub = None
         self._hil_gps_extensions_supported = None
+        self._diagnostic_telemetry = DiagnosticTelemetry()
         self._init_transport()
 
         qos = QoSProfile(
@@ -1656,6 +1658,16 @@ class VioPx4GpsBridge(Node):
             if (self.px4_target_sysid is not None
                     and int(msg.get_srcSystem()) != self.px4_target_sysid):
                 continue
+            # Passive localhost copy only. The diagnostic consumer cannot send
+            # commands back through this socket or take the Cube's serial port.
+            mirror = getattr(self, "_diagnostic_telemetry", None)
+            if (mirror is not None and message_type in ("ATTITUDE", "ODOMETRY")
+                    and self.px4_target_sysid is not None
+                    and int(msg.get_srcComponent()) == self.px4_target_compid):
+                try:
+                    mirror.publish(msg, self.phase.value, self.continuity_recovering)
+                except Exception:
+                    pass  # Even a diagnostic implementation fault is non-fatal.
             if (
                 message_type == "HEARTBEAT"
                 and self.px4_target_sysid is not None
@@ -1977,6 +1989,13 @@ class VioPx4GpsBridge(Node):
         self._gps_pub.publish(msg)
 
 
+    def destroy_node(self):
+        mirror = getattr(self, "_diagnostic_telemetry", None)
+        if mirror is not None:
+            mirror.close()
+        return super().destroy_node()
+
+
 def main(args=None):
     rclpy.init(args=args)
     node = VioPx4GpsBridge()
